# ============================================================
# Evalix — Environment Variables Reference
# ============================================================
# This root file documents every variable used across the three
# services. Each service also has its own .env (copy the relevant
# section into server/.env, client/.env, nlp_service/.env).
# Never commit real .env files — only .env.example files.

# ---------------- server/.env ----------------
MONGODB_URI=mongodb://localhost:27017/evalix
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
FASTAPI_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---------------- client/.env ----------------
VITE_API_URL=http://localhost:5000/api

# ---------------- nlp_service/.env ----------------
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
ENVIRONMENT=development
